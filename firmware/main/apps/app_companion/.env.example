# 複製為同目錄 .env 後修改（.env 勿提交 Git）
# 建置時注入為韌體「預設」；執行期若 NVS companion.pi_ws_url 已寫入則仍以 NVS 為準。
#
# 用法：
#   cp .env.example .env
#   # 編輯 COMPANION_PI_WS_URL
#   cd firmware && idf.py reconfigure build
#
COMPANION_PI_WS_URL=ws://<IP_ADDRESS>:8765/ws/device
# 可空＝開發模式不驗證 token；若 Pi 設了 STACKCHAN_DEVICE_TOKEN 請兩邊一致
COMPANION_PI_TOKEN=
