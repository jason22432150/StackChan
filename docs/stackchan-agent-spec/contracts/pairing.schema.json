{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackchan.local/contracts/pairing.schema.json",
  "title": "StackChan Pairing Messages v0.1 (FROZEN)",
  "$defs": {
    "PairingStartRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "subject_type", "display_name"],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1"
        },
        "subject_type": {
          "type": "string",
          "enum": ["bridge", "device", "dashboard"]
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "client_public_key": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "PairingChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "pairing_id",
        "subject_type",
        "user_code",
        "expires_at"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1"
        },
        "pairing_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "subject_type": {
          "type": "string",
          "enum": ["bridge", "device", "dashboard"]
        },
        "user_code": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PairingConfirmRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "pairing_id", "user_code", "approved"],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1"
        },
        "pairing_id": {
          "type": "string",
          "minLength": 1
        },
        "user_code": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16
        },
        "approved": {
          "type": "boolean"
        }
      }
    },
    "PairingCompleteResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "pairing_id",
        "subject_id",
        "subject_type",
        "access_token",
        "scopes",
        "token_expires_at"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1"
        },
        "pairing_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_type": {
          "type": "string",
          "enum": ["bridge", "device", "dashboard"]
        },
        "access_token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 4096,
          "description": "Opaque short-lived token; never log or TTS"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "token_expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
